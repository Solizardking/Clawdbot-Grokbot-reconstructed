{
  "name": "@clawdbot/control-plane",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "dependencies": {
    "better-auth": "1.7.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260825.1",
    "@cloudflare/vitest-plugin": "1.3.2",
    "@types/node": "^26.2.0",
    "typescript": "^5.8.3",
    "vitest": "^5.0.2",
    "wrangler": "4.143.1"
  },
  "scripts": {
    "check": "npm run types && tsc -p tsconfig.json",
    "test": "vitest run",
    "types": "wrangler types --config wrangler.jsonc worker-configuration.d.ts",
    "types:check": "wrangler types --check --config wrangler.jsonc worker-configuration.d.ts",
    "dry-run": "wrangler deploy --dry-run --config wrangler.jsonc",
    "deploy": "wrangler deploy --config wrangler.jsonc",
    "migrate:local": "wrangler d1 migrations apply clawdbot-control-plane --local --config wrangler.jsonc",
    "migrate:remote": "wrangler d1 migrations apply clawdbot-control-plane --remote --config wrangler.jsonc"
  }
}
