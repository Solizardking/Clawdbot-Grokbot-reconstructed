# Run setup.sh on the Linux engine host to generate machine-specific paths.
COMPOSE_PROJECT_NAME=clawd-bot-podman
OMB_DATA_ROOT=/home/REPLACE_ME/clawd-bot/data
PODMAN_SOCKET=/run/user/1000/podman/podman.sock
OMB_PORT=8799
OMB_WEBHOOK_PORT=8800
OMB_HTTP_PORT=8080
OMB_PUBLIC_URL=http://localhost:8080
OMB_HTTPS_HOST=https-disabled.invalid
ENGINES=

# Optional Composio project key for connected apps.
COMPOSIO_API_KEY=
