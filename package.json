{
  "name": "grok-bot-0.18-reconstructed",
  "version": "0.18.0-reconstructed.1",
  "private": true,
  "type": "module",
  "description": "Source-oriented reconstruction of the publicly shipped Grok Bot 0.18.0 macOS application",
  "engines": {
    "node": ">=26.5.0 <27"
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap-runtime.mjs",
    "build": "node scripts/build.mjs",
    "check": "npm run security:check && npm run typecheck && npm run source:typecheck && npm test",
    "frontend:build": "node ./node_modules/vite/bin/vite.js build --config frontend/vite.config.ts",
    "frontend:recover": "node scripts/recover-frontend.mjs",
    "native:patch": "node scripts/apply-third-party-patches.mjs",
    "native:build:electron": "node scripts/build-tree-sitter-electron.mjs",
    "package": "npm run check && node scripts/package-macos.mjs",
    "package:diagnostic": "npm run check && node scripts/package-fidelity-diagnostic.mjs",
    "publication:check": "npm run security:check && node scripts/verify-publication-tree.mjs",
    "postinstall": "node scripts/apply-third-party-patches.mjs",
    "smoke": "node scripts/smoke.mjs",
    "build:bridge": "node scripts/build-telegram-bridge.mjs",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "node ./node_modules/typescript/bin/tsc --project frontend/tsconfig.json",
    "source:typecheck": "node ./node_modules/typescript/bin/tsc --project source/tsconfig.json",
    "verify": "node scripts/verify.mjs",
    "compare:opengrok": "node scripts/compare-opengrok.mjs",
    "build:service": "node services/telegram-fly/build.mjs",
    "gateway:start": "node --env-file-if-exists=.env services/provider-gateway/server.mjs",
    "gateway:issue-user": "node services/provider-gateway/issue-user.mjs",
    "gateway:deploy": "cd services/provider-gateway && fly deploy --ha=false --remote-only --depot=true",
    "paybox:login": "paybox login",
    "paybox:status": "paybox --json whoami",
    "clawd:typecheck": "node ./node_modules/typescript/bin/tsc --project clawd/tsconfig.json && node ./node_modules/typescript/bin/tsc --project clawd/tsconfig.harness.json",
    "clawd:build": "node ./node_modules/vite/bin/vite.js build --config clawd/vite.config.ts",
    "clawd:server": "node --env-file-if-exists=.env --experimental-strip-types clawd/server/harness-entry.ts",
    "clawd:dev": "node ./node_modules/vite/bin/vite.js --config clawd/vite.config.ts",
    "control-plane:check": "npm run check --prefix clawd/cloudflare/control-plane",
    "control-plane:test": "npm test --prefix clawd/cloudflare/control-plane",
    "control-plane:dry-run": "npm run dry-run --prefix clawd/cloudflare/control-plane",
    "control-plane:deploy": "npm run deploy --prefix clawd/cloudflare/control-plane",
    "composio-broker:test": "npm test --prefix clawd/cloudflare/composio-broker",
    "composio-broker:dry-run": "npm run dry-run --prefix clawd/cloudflare/composio-broker",
    "composio-broker:deploy": "npm run deploy --prefix clawd/cloudflare/composio-broker",
    "deploy": "npm run security:check && npm run build && wrangler deploy",
    "preview": "npm run build && wrangler dev",
    "security:check": "node scripts/check-secrets.mjs",
    "security:history": "node scripts/check-secret-history.mjs"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.1",
    "@electron/asar": "4.2.1",
    "@types/js-yaml": "3.12.10",
