{
  "expo": {
    "name": "Clawd",
    "slug": "clawd-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/clawd.png",
    "scheme": "clawdmobile",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#100b1b",
        "foregroundImage": "./assets/images/clawd.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.clawdbot.mobile",
      "versionCode": 1,
      "permissions": [
        "INTERNET"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-dev-client",
        {
          "showMenuAtLaunch": false,
          "skipOnboarding": true
        }
      ],
      "expo-font",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/clawd.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#100b1b",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      "./plugins/with-clawd-android.cjs"
    ],
    "experiments": {
      "reactCompiler": true,
      "typedRoutes": true
    }
  }
}
